# Copy this file to ".env" (same folder as manage.py) and fill it in. NEVER commit ".env".

# --- required ---
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
# True ONLY on your own computer. Must be False (or absent) on the live site.
DEBUG=True
# from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- live site ---
# e.g. https://biospine.onrender.com  (used in email links)
SITE_URL=http://127.0.0.1:8000
# live: your domain, e.g. biospine.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1
# live: postgresql://user:pass@host:5432/dbname  (empty = local SQLite file)
DATABASE_URL=
# your name or company, shown on the legal pages
OPERATOR_NAME=
# shown on the legal pages; contact-form messages are also emailed here
CONTACT_EMAIL=
# long random string; lets a free cron service trigger the weekly emails
CRON_SECRET=

# --- AI (optional) ---
# False = remove the AI Physio / AI diagnosis / Chats tab from the whole website
AI_ENABLED=True

# leave empty to use the automatic fallback chain; run `python manage.py check_ai` to test
GEMINI_MODEL=
AI_CHAT_PER_DAY=60
# set True once emails really arrive (see DEPLOY.md)
REQUIRE_EMAIL_VERIFICATION=False

# --- email (needed for verification / password reset / weekly report) ---
# e.g. smtp-relay.brevo.com or smtp.gmail.com (empty = emails are printed in the terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Gmail/Brevo: use the address you log in with
DEFAULT_FROM_EMAIL=BioSpine <no-reply@yourdomain.com>
# Test it:  python manage.py check_email you@example.com

# --- optional ---
# error tracking (free tier at sentry.io)
SENTRY_DSN=
# timezone of the staff analytics charts
ANALYTICS_TIMEZONE=Asia/Kolkata
